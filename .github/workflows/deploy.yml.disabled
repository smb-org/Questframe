# NICHT EINGERICHTET — dieser Workflow ist absichtlich deaktiviert.
#
# GitHub liest in .github/workflows/ ausschliesslich .yml und .yaml. Durch die
# Endung .disabled ist diese Datei kein Workflow: sie taucht in der
# Actions-Oberflaeche nicht auf und laesst sich weder automatisch noch von Hand
# starten. Deployt wird ausschliesslich lokal ueber `pnpm run deploy:staging`
# beziehungsweise `pnpm run deploy:production`.
#
# Zum Aktivieren: Datei nach deploy.yml umbenennen und VORHER je Environment
# (staging, production) diese Secrets hinterlegen:
#   PUBLIC_ORIGIN          vollstaendiger https-Origin der Umgebung
#   CLOUDFLARE_API_TOKEN   Token mit Deploy-Rechten fuer den Worker
#   CLOUDFLARE_ACCOUNT_ID  Cloudflare-Account-ID
# Fehlt PUBLIC_ORIGIN, bricht der Build-Schritt ab, bevor etwas deployt wird.

name: Deploy

on:
  workflow_dispatch:
    inputs:
      target:
        description: Isolierte Cloudflare-Umgebung
        required: true
        type: choice
        options: [staging, production]

permissions:
  contents: read

concurrency:
  group: irl-stream-hud-${{ inputs.target }}
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 25
    environment: ${{ inputs.target }}
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm exec playwright install --with-deps chromium
      - run: pnpm run check
      - name: Build selected Cloudflare environment
        run: pnpm run "build:${{ inputs.target }}"
        env:
          PUBLIC_ORIGIN: ${{ secrets.PUBLIC_ORIGIN }}
      - name: Deploy exact tested commit
        # Der Host steht bewusst in einer eigenen Zuweisung: in
        # `--domains "$(…)"` verschluckt die Kommandosubstitution einen
        # Fehler, und ein leerer Wert ginge gegen den laufenden Worker.
        run: |
          DEPLOY_HOST="$(node -e 'process.stdout.write(new URL(process.env.PUBLIC_ORIGIN).host)')"
          pnpm exec wrangler deploy --domains "$DEPLOY_HOST"
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          PUBLIC_ORIGIN: ${{ secrets.PUBLIC_ORIGIN }}
