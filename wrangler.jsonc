{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "irl-stream-hud-local",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/ws/*", "/healthz"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CHANNEL", "class_name": "ChannelObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChannelObject"] }],
  "ratelimits": [
    {
      "name": "OVERLAY_CAPSULE_LIMITER",
      "namespace_id": "11001",
      "simple": { "limit": 300, "period": 10 }
    },
    {
      "name": "OVERLAY_TOKEN_LIMITER",
      "namespace_id": "11002",
      "simple": { "limit": 100, "period": 10 }
    },
    {
      "name": "DOCK_TOKEN_LIMITER",
      "namespace_id": "11003",
      "simple": { "limit": 100, "period": 10 }
    },
    {
      "name": "DOCK_IP_LIMITER",
      "namespace_id": "11004",
      "simple": { "limit": 100, "period": 10 }
    },
    {
      "name": "OVERLAY_IP_LIMITER",
      "namespace_id": "11005",
      "simple": { "limit": 100, "period": 10 }
    }
  ],
  "vars": {
    "APP_ENV": "local",
    "RELEASE_STAGE": "v1b"
  },
  "secrets": {
    "required": [
      "TWITCH_CLIENT_ID",
      "TWITCH_CLIENT_SECRET",
      "BROADCASTER_ID",
      "PUBLIC_ORIGIN",
      "CAPSULE_ID",
      "CAPSULE_NAME",
      "TIMEZONE",
      "SESSION_COOKIE_KEYS",
      "SESSION_ENCRYPTION_KEYS",
      "OVERLAY_TOKEN_PEPPER"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "env": {
    "staging": {
      "name": "irl-stream-hud-staging",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/auth/*", "/ws/*", "/healthz"]
      },
      "durable_objects": {
        "bindings": [{ "name": "CHANNEL", "class_name": "ChannelObject" }]
      },
      "ratelimits": [
        {
          "name": "OVERLAY_CAPSULE_LIMITER",
          "namespace_id": "12001",
          "simple": { "limit": 300, "period": 10 }
        },
        {
          "name": "OVERLAY_TOKEN_LIMITER",
          "namespace_id": "12002",
          "simple": { "limit": 100, "period": 10 }
        },
        {
          "name": "DOCK_TOKEN_LIMITER",
          "namespace_id": "12003",
          "simple": { "limit": 100, "period": 10 }
        },
        {
          "name": "DOCK_IP_LIMITER",
          "namespace_id": "12004",
          "simple": { "limit": 100, "period": 10 }
        },
        {
          "name": "OVERLAY_IP_LIMITER",
          "namespace_id": "12005",
          "simple": { "limit": 100, "period": 10 }
        }
      ],
      "vars": {
        "APP_ENV": "staging",
        "RELEASE_STAGE": "v1b"
      },
      "secrets": {
        "required": [
          "TWITCH_CLIENT_ID",
          "TWITCH_CLIENT_SECRET",
          "BROADCASTER_ID",
          "PUBLIC_ORIGIN",
          "CAPSULE_ID",
          "CAPSULE_NAME",
          "TIMEZONE",
          "SESSION_COOKIE_KEYS",
          "SESSION_ENCRYPTION_KEYS",
          "OVERLAY_TOKEN_PEPPER"
        ]
      }
    },
    "production": {
      "name": "irl-stream-hud",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/auth/*", "/ws/*", "/healthz"]
      },
      "durable_objects": {
        "bindings": [{ "name": "CHANNEL", "class_name": "ChannelObject" }]
      },
      "ratelimits": [
        {
          "name": "OVERLAY_CAPSULE_LIMITER",
          "namespace_id": "13001",
          "simple": { "limit": 300, "period": 10 }
        },
        {
          "name": "OVERLAY_TOKEN_LIMITER",
          "namespace_id": "13002",
          "simple": { "limit": 100, "period": 10 }
        },
        {
          "name": "DOCK_TOKEN_LIMITER",
          "namespace_id": "13003",
          "simple": { "limit": 100, "period": 10 }
        },
        {
          "name": "DOCK_IP_LIMITER",
          "namespace_id": "13004",
          "simple": { "limit": 100, "period": 10 }
        },
        {
          "name": "OVERLAY_IP_LIMITER",
          "namespace_id": "13005",
          "simple": { "limit": 100, "period": 10 }
        }
      ],
      "vars": {
        "APP_ENV": "production",
        "RELEASE_STAGE": "v1b"
      },
      "secrets": {
        "required": [
          "TWITCH_CLIENT_ID",
          "TWITCH_CLIENT_SECRET",
          "BROADCASTER_ID",
          "PUBLIC_ORIGIN",
          "CAPSULE_ID",
          "CAPSULE_NAME",
          "TIMEZONE",
          "SESSION_COOKIE_KEYS",
          "SESSION_ENCRYPTION_KEYS",
          "OVERLAY_TOKEN_PEPPER"
        ]
      }
    }
  }
}
