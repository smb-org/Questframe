{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "irl-stream-hud-local",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/ws/*", "/healthz"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CHANNEL", "class_name": "ChannelObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChannelObject"] }],
  "ratelimits": [
    {
      "name": "OVERLAY_CAPSULE_LIMITER",
      "namespace_id": "11001",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "OVERLAY_TOKEN_LIMITER",
      "namespace_id": "11002",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "vars": {
    "APP_ENV": "local",
    "RELEASE_STAGE": "v1b",
    "TWITCH_CLIENT_ID": "local-twitch-client-id",
    "BROADCASTER_ID": "12345678901234567890",
    "PUBLIC_ORIGIN": "http://localhost:5173",
    "CAPSULE_ID": "irl-stream-hud-local",
    "CAPSULE_NAME": "IRL Stream HUD Local",
    "TIMEZONE": "Europe/Berlin"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "env": {
    "staging": {
      "name": "irl-stream-hud-staging",
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/auth/*", "/ws/*", "/healthz"]
      },
      "durable_objects": {
        "bindings": [{ "name": "CHANNEL", "class_name": "ChannelObject" }]
      },
      "ratelimits": [
        {
          "name": "OVERLAY_CAPSULE_LIMITER",
          "namespace_id": "12001",
          "simple": { "limit": 12, "period": 60 }
        },
        {
          "name": "OVERLAY_TOKEN_LIMITER",
          "namespace_id": "12002",
          "simple": { "limit": 6, "period": 60 }
        }
      ],
      "vars": {
        "APP_ENV": "staging",
        "RELEASE_STAGE": "v1a",
        "TWITCH_CLIENT_ID": "SET_STAGING_TWITCH_CLIENT_ID",
        "BROADCASTER_ID": "SET_STAGING_BROADCASTER_ID",
        "PUBLIC_ORIGIN": "SET_STAGING_PUBLIC_ORIGIN",
        "CAPSULE_ID": "irl-stream-hud-staging",
        "CAPSULE_NAME": "IRL Stream HUD Staging",
        "TIMEZONE": "Europe/Berlin"
      }
    },
    "production": {
      "name": "irl-stream-hud",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/auth/*", "/ws/*", "/healthz"]
      },
      "durable_objects": {
        "bindings": [{ "name": "CHANNEL", "class_name": "ChannelObject" }]
      },
      "ratelimits": [
        {
          "name": "OVERLAY_CAPSULE_LIMITER",
          "namespace_id": "13001",
          "simple": { "limit": 12, "period": 60 }
        },
        {
          "name": "OVERLAY_TOKEN_LIMITER",
          "namespace_id": "13002",
          "simple": { "limit": 6, "period": 60 }
        }
      ],
      "vars": {
        "APP_ENV": "production",
        "RELEASE_STAGE": "v1a",
        "TWITCH_CLIENT_ID": "SET_PRODUCTION_TWITCH_CLIENT_ID",
        "BROADCASTER_ID": "SET_PRODUCTION_BROADCASTER_ID",
        "PUBLIC_ORIGIN": "SET_PRODUCTION_PUBLIC_ORIGIN",
        "CAPSULE_ID": "irl-stream-hud",
        "CAPSULE_NAME": "IRL Stream HUD",
        "TIMEZONE": "Europe/Berlin"
      }
    }
  }
}
